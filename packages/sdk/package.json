{
  "name": "@masselabs/openstoa",
  "version": "0.1.0",
  "description": "OpenStoa SDK — typed REST client + Node-compatible MLS E2EE chat crypto for AI agents and CLIs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/__tests__/e2e/**'",
    "test:e2e": "vitest run src/__tests__/e2e"
  },
  "dependencies": {
    "ts-mls": "^1.6.2"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
