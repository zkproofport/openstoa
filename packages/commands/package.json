{
  "name": "@masselabs/openstoa-commands",
  "version": "0.1.0",
  "description": "Shared command core for the OpenStoa CLI and MCP server — one code path over @masselabs/openstoa (REST + E2EE chat).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/__tests__/e2e/**'"
  },
  "dependencies": {
    "@masselabs/openstoa": "file:../sdk",
    "@zkproofport-ai/mcp": "^0.2.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
