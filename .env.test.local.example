# Local E2E overrides — copy to `.env.test.local` (gitignored) to run the e2e
# suite against a local server with NO deploy. Values here override the
# committed staging defaults in `.env.test`; a shell env var overrides both.
#
#   cp .env.test.local.example .env.test.local
#   npm run test:e2e:local            # or: npm run test:e2e (uses these values)
#
# `npm run test:e2e:local` already sets E2E_BASE_URL=http://localhost:3200, so
# you only strictly need this file for the few tests that seed rows directly in
# the DB (e.g. the SI-6b private-topic check) — without DATABASE_URL those skip
# cleanly.

# Local Next.js dev server (started via scripts/dev.sh / next dev on :3200).
E2E_BASE_URL=http://localhost:3200

# Local Postgres — required by db-seeded e2e checks (otherwise they skip).
# Match your .env.local DATABASE_URL.
DATABASE_URL=postgresql://USER:PASS@localhost:5432/openstoa
