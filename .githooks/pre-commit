#!/usr/bin/env bash
# Pre-commit hook for OpenStoa
# Auto-generates drizzle migrations and skill.md when relevant files change

set -e

# Check if schema.ts changed
if git diff --cached --name-only | grep -q "src/lib/db/schema.ts"; then
  echo "📦 schema.ts changed — generating Drizzle migration..."
  DATABASE_URL="${DATABASE_URL:-postgresql://proofport:proofport@localhost:5432/openstoa}" \
    npx drizzle-kit generate 2>/dev/null || {
      echo "⚠️  drizzle-kit generate failed (DB may not be running). Migration not generated."
      echo "   Run manually: DATABASE_URL=... npx drizzle-kit generate"
    }
  # Stage any generated migration files
  git add drizzle/ 2>/dev/null || true
  echo "✅ Migration files generated and staged"
fi

# Check if anything that feeds skill.md changed:
#   - src/app/api/  → swagger-jsdoc reads the JSDoc on every route handler
#   - AGENTS.md     → generate-skill.ts uses it as the base narrative document
# Either one going out of sync would mean AI/CLI clients read stale guidance
# (the f4a6877 multipart switch shipped without regenerating skill.md, which
# is exactly the trap this hook is meant to prevent).
if git diff --cached --name-only | grep -qE "src/app/api/|^AGENTS\.md$"; then
  echo "📄 API routes or AGENTS.md changed — regenerating skill.md + openapi-spec.json..."
  npx tsx scripts/generate-skill.ts 2>/dev/null || {
    echo "⚠️  generate-skill.ts failed. Run manually: npm run generate:skill"
  }
  # generate-skill.ts writes three files; stage every one of them so they
  # ship in the same commit as the source change.
  git add public/skill.md public/AGENTS.md src/generated/openapi-spec.json 2>/dev/null || true
  echo "✅ skill.md, public/AGENTS.md, openapi-spec.json regenerated and staged"
fi

# SI-1 plaintext-absence gate (source check only — DB may be down at commit time).
# Runs whenever any chat route file is staged.
# Aborts the commit if the plaintext-rejection guard is absent from the POST handler.
# The guard string "'message' in body" in route.ts is the server-side SI-1 enforcement
# point; its removal would silently allow plaintext chat bodies to reach the DB.
if git diff --cached --name-only | grep -qE "src/app/api/topics/\[topicId\]/chat/"; then
  echo "🔒 Chat route staged — running SI-1 source check..."
  # Run only the source check (exits 0 when guard present, 1 when missing).
  # Pipe DATABASE_URL as empty so the script skips the DB check and stays fast.
  if DATABASE_URL="" npx tsx scripts/check-no-plaintext-chat.ts 2>&1; then
    echo "✅ SI-1 source check passed"
  else
    echo "❌ SI-1 source check FAILED — commit aborted."
    echo "   The plaintext-rejection guard is missing from the chat POST route."
    echo "   Restore: if ('message' in body) { return 400 } in route.ts before committing."
    exit 1
  fi
fi
